# MongoDB Atlas Connection URI (Free M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolionow?retryWrites=true&w=majority

# NextAuth Secret & Base URL
NEXTAUTH_SECRET=generate_a_random_32_character_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin Access Credentials
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=SetAStrongPasswordHere!

# Cloudinary (Free tier for project and avatar media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Digital Twin API Keys (Free Tier)
# Option A: Groq Cloud (Free high-speed Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: Google Gemini (Free tier)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
